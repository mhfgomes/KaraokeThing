# Copy to .env.local. Relative paths are resolved from the project root.
KARAOKE_DATA_DIR=./data
KARAOKE_HOST=0.0.0.0
PORT=3100
# Allowed host music folders; macOS/Linux use colon, Windows uses semicolon.
# KARAOKE_IMPORT_ROOTS=/Users/you/Music:/mnt/music
# Optional FFmpeg override:
# FFMPEG_PATH=/path/to/ffmpeg
# HTTPS development server; LAN devices must trust the certificate.
# KARAOKE_HTTPS=1
# Experimental word alignment is disabled by default; current singing accuracy is insufficient.
# KARAOKE_EXPERIMENTAL_WORD_ALIGNMENT=1
