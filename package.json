{
  "name": "karaokething",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @karaokething/web run dev",
    "build": "pnpm --filter @karaokething/web run build",
    "start": "pnpm --filter @karaokething/web run start",
    "worker": "pnpm --filter @karaokething/web run worker",
    "model:install": "pnpm --filter @karaokething/web run model:install",
    "alignment:model:install": "pnpm --filter @karaokething/web run alignment:model:install",
    "lint": "pnpm --filter @karaokething/web run lint",
    "typecheck": "pnpm --filter @karaokething/web run typecheck",
    "test": "pnpm --filter @karaokething/web run test",
    "ci": "pnpm --filter @karaokething/web run ci",
    "desktop": "pnpm --filter @karaokething/desktop run start",
    "desktop:dist": "pnpm --filter @karaokething/desktop run dist",
    "desktop:ci": "pnpm --filter @karaokething/desktop run ci"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.12.0"
  }
}
