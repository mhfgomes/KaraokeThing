{
  "name": "karaokething",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx scripts/launch.ts",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local --import tsx scripts/launch.ts --production",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker/index.ts",
    "model:install": "node --env-file-if-exists=.env.local --import tsx scripts/install-model.ts",
    "alignment:model:install": "node --env-file-if-exists=.env.local --import tsx scripts/install-alignment-model.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts src/worker/*.test.ts"
  },
  "dependencies": {
    "@audio/neural-separate": "^0.4.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.54.0",
    "music-metadata": "^12.1.0",
    "next": "16.4.0",
    "onnxruntime-node": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "type": "module"
