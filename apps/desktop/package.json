{
  "name": "@karaokething/desktop",
  "productName": "KaraokeThing Stage",
  "version": "0.2.0",
  "description": "Full-screen stage display for KaraokeThing: lyrics on the screen, sound through the speakers. Controlled from the host's admin panel.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check main.mjs && node --check preload.cjs && node --check pages/setup.js && node --check pages/offline.js",
    "pack": "electron-builder --dir --publish never",
    "ci": "pnpm run check && pnpm run pack",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.karaokething.stage",
    "executableName": "karaokething-stage",
    "productName": "KaraokeThing Stage",
    "files": [
      "main.mjs",
      "preload.cjs",
      "pages/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "KaraokeThing Stage plays singers' microphones through the speakers when the host turns them on."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "AudioVideo",
      "maintainer": "Mário Gomes <mhfgomes@users.noreply.github.com>"
    },
    "artifactName": "KaraokeThing-Stage-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "KaraokeThing-Stage-${version}-${os}-${arch}-portable.${ext}"
    }
  },
  "author": {
    "name": "Mário Gomes",
    "email": "mhfgomes@users.noreply.github.com"
  },
  "homepage": "https://github.com/mhfgomes/KaraokeThing"
}
